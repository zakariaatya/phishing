# Copier ce fichier en ".env" (utilise seulement en local pour npm run import)
# Ces memes valeurs doivent aussi etre ajoutees dans Vercel > Settings > Environment Variables

# Obtenus apres creation de la base sur turso.tech (voir README)
TURSO_DATABASE_URL=libsql://votre-base.turso.io
TURSO_AUTH_TOKEN=votre-token-turso

# Identifiants d'acces au tableau de bord
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change-moi-en-un-mot-de-passe-solide

# URL publique de votre projet (donnee par Vercel, ou votre domaine une fois branche)
PUBLIC_URL=https://votre-projet.vercel.app
